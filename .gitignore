*~
*.bak

# Training data (large files - download separately via Kaggle)
bridge/training/data/
!bridge/training/data/.gitkeep

# NOTE: Trained model artifacts ARE tracked in git (they're small enough)
# bridge/marbel/artifacts/ - XGBoost models (~8MB total)
# bridge/gnn/artifacts/ - GNN models (~5MB total)

# Kaggle credentials (sensitive)
.kaggle/
kaggle.json

# Any locally-supplied bank/operator handoff documents (private by default —
# jurisdiction packs should not redistribute a specific institution's source PDFs)
docs/jurisdictions/*/pdfs/
New folder (2)/
*.docx

