{
  "permissions": {
    "allow": [
      "Bash(sg docker -c \"docker ps*\")",
      "Bash(sg docker -c \"docker ps -a*\")",
      "Bash(sg docker -c \"docker compose ps*\")",
      "Bash(sg docker -c \"docker logs*\")",
      "Bash(sg docker -c \"docker compose logs*\")",
      "Bash(sg docker -c \"docker images*\")",
      "Bash(sg docker -c \"docker inspect *\")",
      "Bash(sg docker -c \"docker version*\")",
      "Bash(sg docker -c \"docker compose version*\")",

      "Bash(curl -sS http://localhost:*)",
      "Bash(curl -sS --max-time * http://localhost:*)",
      "Bash(curl -sS --max-time * -o /dev/null*)",

      "Bash(command -v *)"
    ]
  }
}
