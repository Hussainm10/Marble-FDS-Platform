{
  "_metadata": {
    "purpose": "Reference test scenarios for the pakistan jurisdiction pack. Each scenario is a complete /decide request body with an expected_outcome describing the correct rule activation. These are used to validate the pack post-deployment, NOT loaded by the platform tests in tests/test_*.py.",
    "usage": "After provisioning the pack, iterate through scenarios and POST each to http://localhost:8000/decide. Compare the response decision/escalation/compliance against expected_outcome.",
    "scenario_id_placeholder": "All scenario_id fields contain '<TXN_RISK_SCORING_ID>'. Replace with the actual UUID of the transaction_risk_scoring scenario from the deployed org's GET /scenarios call."
  },
