# =============================================================================
# Marble FDS — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# See SECURITY.md for secret generation/rotation procedures.
# =============================================================================

# --- PostgreSQL ---
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_strong_password_here
PG_DATABASE=marble
PG_PORT=55432  # Use 55432 (not 5432) if your host already runs PostgreSQL on 5432

# --- JWT Authentication ---
# Generate: openssl rand -hex 32
JWT_SIGNING_KEY=CHANGE_ME_jwt_signing_key

# --- Marble Organization Bootstrap ---
# Change CREATE_ORG_NAME to your operator name (e.g., "MyBank Pakistan").
# CREATE_ORG_ADMIN_EMAIL is used for the bootstrap admin account.
CREATE_ORG_NAME=MarbleFDS
CREATE_ORG_ADMIN_EMAIL=admin@example.com

# --- License (leave as-is for dev/eval) ---
LICENSE_KEY=LICENSE_KEY

# --- Ports ---
API_PORT=8080
APP_PORT=3000
BRIDGE_PORT=8000

# --- Session ---
SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_characters

# --- Bucket URLs (empty for local dev, set for production) ---
INGESTION_BUCKET_URL=
CASE_MANAGER_BUCKET_URL=
ANALYTICS_BUCKET_URL=

# --- Firebase Auth (real project) ---
# Create a free Firebase project at https://console.firebase.google.com,
# enable Email/Password under Authentication → Sign-in method, then paste the
# values from Project Settings → Your apps → Web app config here.
# Note: FIREBASE_API_KEY is a public client identifier — safe to share, but kept
# in .env for consistency. To use the local emulator instead, see docker-compose.yml
# (uncomment FIREBASE_AUTH_EMULATOR_HOST and replace the env-var refs with placeholders).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=

# --- Bridge Service ---
# CHECKMARBLE_API_KEY: a real Marble-issued key (role=API_CLIENT). Generate
# from the Marble UI under Settings → API keys, or via POST /apikeys after
# logging in. Marble only honors keys it issued itself — random hex won't work.
CHECKMARBLE_API_KEY=
MARBEL_API_URL=http://marbel:5000
GNN_API_URL=http://gnn:5001
MARBEL_ESCALATION_THRESHOLD=40
GNN_ESCALATION_THRESHOLD=60
LOG_LEVEL=info

# --- Admin Bootstrap ---
# Required for scripts/setup.py and tests. No default — script exits if unset.
ADMIN_PASSWORD=

# --- Pakistan jurisdiction pack — Islamic banking scenarios ---
# Set to "true" to publish the 8 optional Islamic-banking rules
# (shariah_contract_compliance + wakalah_delegation_compliance) when running
# scripts/rules_library/pakistan.py. Defaults to "false" if unset.
ENABLE_ISLAMIC_SCENARIOS=false

# --- Production Hardening (all opt-in; off by default for dev) ---
# Set BRIDGE_API_KEY to require X-Bridge-API-Key header on bridge endpoints.
# Set WEBHOOK_SECRET to require HMAC-SHA256 X-Webhook-Signature on /webhooks/checkmarble.
# DEBUG_DETAILS=true exposes full exception strings in error responses (DEV ONLY).
BRIDGE_API_KEY=
WEBHOOK_SECRET=
DEBUG_DETAILS=false
